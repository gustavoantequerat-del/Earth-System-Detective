# Copiar como .streamlit/secrets.toml (local) o pegar en Streamlit Community Cloud > App settings > Secrets.
# Nunca subir el archivo real a GitHub (ya esta en .gitignore).

# Asistente con IA (Claude): explicaciones sencillas y preguntas. Clave de https://console.anthropic.com
ANTHROPIC_API_KEY = ""

# Alertas por Telegram (opcional): token de @BotFather y el id del canal o grupo
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""

# Earth Engine en la web (opcional): sin esto el mapa usa la imagen satelital de Esri y todo lo demas funciona.
# Pegar aqui los campos del JSON de la cuenta de servicio (Google Cloud > IAM > Cuentas de servicio > Claves).
[gee_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
