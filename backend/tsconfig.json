{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "skipLibCheck": true, "strict": true,
    "sourceMap": true, "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
